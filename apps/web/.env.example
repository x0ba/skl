# API origin. Keep the `/v1` prefix on paths; this is only the host.
NEXT_PUBLIC_API_BASE=http://localhost:8787

# Clerk — set both to enable hosted sign-in. The web app then sends
# `Authorization: Bearer <clerk_session_jwt>` from `getToken()`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Used when Clerk is unset (or the user is signed out). Default Bearer
# token is `dev:<this id>`. The API accepts that only when
# CLERK_SECRET_KEY is unset (ALLOW_DEV_AUTH).
NEXT_PUBLIC_DEV_USER_ID=local-dev

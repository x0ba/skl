# Postgres (matches root docker-compose.yml)
DATABASE_URL=postgres://skl:skl@localhost:5432/skl

# Listen address for `pnpm dev` / `pnpm start`
PORT=8787

# Public origins used in device-auth verification URIs and CORS
SKL_WEB_ORIGIN=http://localhost:3000
SKL_API_ORIGIN=http://localhost:8787

# Clerk — required in production. Leave unset locally to accept
# `Authorization: Bearer dev:<clerk_user_id>` (ALLOW_DEV_AUTH defaults on).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# Unset (default): on when CLERK_SECRET_KEY is empty.
# true: keep Bearer dev:<id> even if Clerk is configured.
# false: disables the local bypass — /device with `dev:<id>` then returns clerk_not_configured.
# ALLOW_DEV_AUTH=true
